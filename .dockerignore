# Keep the build context to what the image needs: the code, requirements, licence, docs (including docs/eval_results) and docker/entrypoint.sh.
# Everything below is either private data from a real mesh or only useful on a developer's computer.
.git
.github
.gitattributes
.gitignore
.venv
.claude
.vscode
.idea

# private data: the database, backups, logs, map-tile cache, anything in private/
*.db
*.db-journal
*.db-wal
*.db-shm
audit.db
*.hash
secrets
backups
logs
tile_cache
private
.env
.env.*
!.env.example

# not needed at run time
tests
docs/screenshots
screenshots
__pycache__
**/__pycache__
*.pyc
setup.sh
setup.bat
scripts
Dockerfile
docker-compose*.yml
docker/docker-compose*.yml
docs/TODO.md
.dockerignore
