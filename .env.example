# Settings for docker-compose.yml. Copy this file to .env (git ignores it) and change what you need. Everything is optional.
# There are no passwords or keys here, and none belong here.

# The port where the dashboard appears (on 127.0.0.1, this computer only, unless you opt in to the LAN below).
#MESHLLM_WEB_PORT=8080

# THE DASHBOARD LOGIN (docker-compose.login.yml). Make the password hash on the host with  python -m meshllm --set-password  and put the
# ABSOLUTE path of the file it wrote here (Compose does not expand ~). The file holds only a hash, but treat it as a secret: it is passed
# to the container as a Compose secret, never as an environment variable. Then start with the override file:
#   docker compose -f docker-compose.yml -f docker-compose.login.yml up -d
# or set this once instead (add :docker-compose.usb.yml for a USB radio) and use plain `docker compose up -d`:
#COMPOSE_FILE=docker-compose.yml:docker-compose.login.yml
#MESHLLM_ADMIN_HASH_FILE=/absolute/path/to/admin.hash

# ANOTHER COMPUTER OR A PHONE (opt-in). Publish the dashboard on an address of THIS computer other than 127.0.0.1, and name what you will
# type in the browser. The container REFUSES TO START unless the login above is set up AND MESHLLM_ALLOWED_HOSTS is not empty. Without HTTPS
# the password travels in clear text: only on a network you trust (docs/setup.md). Never 0.0.0.0 on a computer that faces the internet.
#MESHLLM_WEB_BIND=192.0.2.10
#MESHLLM_ALLOWED_HOSTS=192.0.2.10,radio.test

# Wi-Fi radio: its address on your network (HOST or HOST:PORT; the port is 4403 unless you add one). Not yet tested on real hardware.
#MESHLLM_TCP=192.168.1.50

# Failover: more ways to reach the same radio, tried in this order after the one above (or after USB), comma-separated KIND:VALUE with
# KIND usb or tcp. Bluetooth (ble:) does not work in a container. Not tested on real hardware; see docs/setup.md, Failover.
#MESHLLM_FALLBACK=tcp:192.168.1.50

# USB radio (docker-compose.usb.yml, Linux only): the device and the number of the group that owns it (`stat -c %g /dev/ttyUSB0`).
# python setup_env.py --docker finds and writes both for you.
#MESHLLM_SERIAL_DEVICE=/dev/ttyUSB0
#MESHLLM_SERIAL_GID=20

# The Ollama model to use. Leave empty to keep the one chosen in the dashboard. The first `docker compose up` downloads llama3.2:3b (about 2 GB)
# when no model is installed yet (the model-pull service; follow it with `docker compose logs -f model-pull`). Naming a model here makes it
# download that one instead; MESHLLM_PULL_MODEL=0 turns the download off.
#MESHLLM_MODEL=llama3.2:3b
#MESHLLM_PULL_MODEL=1

# Any other bridge flags (see docs/flags.md), split like a shell would, for example:
#MESHLLM_EXTRA_ARGS=--access-mode allowlist --daily-cap 20
